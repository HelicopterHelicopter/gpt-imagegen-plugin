#!/usr/bin/env bash
# Launches the bundled CLI. The plugin ships a single self-contained
# artifact at dist/index.cjs (built by `make bundle` from src/cli.js and
# committed to git, so a clone needs no `npm install` and there is no
# separate binary to locate or download). This shim's only job is to find
# that file relative to its own location and hand off to `node`.
#
# There used to be a three-way binary search here ($GPT_IMAGEGEN_BIN, a
# local Go build, a downloaded release binary) because a compiled
# per-platform binary could simply be absent. That entire class of failure
# is gone now that the artifact is JS committed alongside this script, so
# $GPT_IMAGEGEN_BIN has been dropped rather than repurposed -- there is
# nothing left to override. The only missing-runtime case that remains is
# `node` itself not being installed, handled below.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bundle="$here/../../../dist/index.cjs"

if ! command -v node >/dev/null 2>&1; then
  echo '{"ok":false,"error":{"code":"NODE_MISSING","message":"node was not found on PATH. Install Node.js 20 or later (see https://nodejs.org) and try again."}}'
  exit 1
fi

exec node "$bundle" "$@"
